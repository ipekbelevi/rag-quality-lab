# Copy this file to .env and fill in your own values.
# .env is git-ignored; .env.example is the public template.

# --- System under test: the chatbot (Anthropic) ---
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-haiku-5-5

# --- Judge + embeddings (OpenAI) ---
# A different model family judges the chatbot to reduce self-preference bias.
OPENAI_API_KEY=
JUDGE_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- Phase 6: Langfuse tracing (optional: without keys tracing is a no-op) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU: https://cloud.langfuse.com   US: https://us.cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com
# TRACING=off disables tracing even when keys are set; TRACE_TAGS=eval,baseline tags traces
TRACING=on
TRACE_TAGS=
